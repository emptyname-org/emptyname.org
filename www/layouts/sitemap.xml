{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  {{- range site.Pages }}{{ if .Permalink }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>{{ end }}
    {{- /* sitemap image extension: claim this page's images (gallery lines +
           markdown images, all under /uploads/) so reverse-image search routes
           copies to the canonical page */ -}}
    {{- range findRE `/uploads/[^\s|")]+?\.(?:png|jpe?g|webp|gif)` .RawContent | uniq }}
    <image:image><image:loc>{{ . | absURL }}</image:loc></image:image>
    {{- end }}
    {{- /* artwork pages carry their image list in params (canonical home of each) */ -}}
    {{- range .Params.images }}
    <image:image><image:loc>{{ . | absURL }}</image:loc></image:image>
    {{- end }}
  </url>
  {{- end }}{{ end }}
  {{- /* the /riverscape/ static sub-app pages (served verbatim, not Hugo content).
         English-only assets - emit once, in the default-language sitemap, so the
         same URLs don't repeat across every per-language sitemap. */ -}}
  {{ if eq site.Language.Lang "en" }}{{ range (slice "riverscape/compositions.html" "riverscape/score.html") }}
  <url>
    <loc>{{ . | absURL }}</loc>
  </url>
  {{- end }}{{ end }}
</urlset>
